{
  "name": "cloudwatchmetricshistory",
  "version": "1.0.0",
  "description": "Lambda function to provide cloudwatch history metrics",
  "license": "ISC",
  "author": "Mike Garthwaite",
  "type": "module",
  "main": "handler.ts",
  "scripts": {
    "test": "vitest run --coverage",
    "lint": "eslint src",
    "codelint": "npm run lint src/ && tsc --noEmit",
    "build": "node esbuild.mjs",
    "zip": "cd dist && zip -r function.zip .",
    "deploy": "npm run lint && npm run build && npm run zip && bash scripts/deploy.sh",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1060.0",
    "@aws-sdk/client-ec2": "^3.1060.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.161",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.2.7"
  }
}
